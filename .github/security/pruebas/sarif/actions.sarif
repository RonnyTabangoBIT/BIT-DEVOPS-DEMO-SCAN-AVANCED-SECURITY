{
 "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
 "version": "2.1.0",
 "runs": [
  {
   "tool": {
    "driver": {
     "name": "CodeQL",
     "semanticVersion": "2.20.0",
     "rules": []
    },
    "extensions": [
     {
      "name": "codeql/actions-queries",
      "rules": [
       {
        "id": "actions/code-injection/medium",
        "properties": {
         "security-severity": "5.0",
         "tags": [
          "security"
         ]
        }
       }
      ]
     }
    ]
   },
   "results": [
    {
     "ruleId": "actions/code-injection/medium",
     "rule": {
      "id": "actions/code-injection/medium",
      "toolComponent": {
       "index": 0
      }
     },
     "message": {
      "text": "Potential code injection in ${{ github.event.head_commit.message }}."
     },
     "locations": [
      {
       "physicalLocation": {
        "artifactLocation": {
         "uri": ".github/workflows/advanced-security.yml"
        },
        "region": {
         "startLine": 32
        }
       }
      }
     ]
    }
   ]
  }
 ]
}