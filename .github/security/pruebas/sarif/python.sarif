{
 "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
 "version": "2.1.0",
 "runs": [
  {
   "tool": {
    "driver": {
     "name": "CodeQL",
     "semanticVersion": "2.20.0",
     "rules": []
    },
    "extensions": [
     {
      "name": "codeql/python-queries",
      "rules": [
       {
        "id": "py/sql-injection",
        "properties": {
         "security-severity": "8.8",
         "tags": [
          "security"
         ]
        }
       },
       {
        "id": "py/command-line-injection",
        "properties": {
         "security-severity": "9.8",
         "tags": [
          "security"
         ]
        }
       },
       {
        "id": "py/reflective-xss",
        "properties": {
         "security-severity": "6.1",
         "tags": [
          "security"
         ]
        }
       },
       {
        "id": "py/path-injection",
        "properties": {
         "security-severity": "7.5",
         "tags": [
          "security"
         ]
        }
       },
       {
        "id": "py/flask-debug",
        "properties": {
         "security-severity": "7.5",
         "tags": [
          "security"
         ]
        }
       },
       {
        "id": "py/unsafe-deserialization",
        "properties": {
         "security-severity": "9.8",
         "tags": [
          "security"
         ]
        }
       },
       {
        "id": "py/weak-sensitive-data-hashing",
        "properties": {
         "security-severity": "7.5",
         "tags": [
          "security"
         ]
        }
       },
       {
        "id": "py/url-redirection",
        "properties": {
         "security-severity": "6.1",
         "tags": [
          "security"
         ]
        }
       },
       {
        "id": "py/unused-import",
        "properties": {
         "tags": [
          "maintainability"
         ]
        }
       }
      ]
     }
    ]
   },
   "results": [
    {
     "ruleId": "py/sql-injection",
     "rule": {
      "id": "py/sql-injection",
      "toolComponent": {
       "index": 0
      }
     },
     "message": {
      "text": "This SQL query depends on a user-provided value."
     },
     "locations": [
      {
       "physicalLocation": {
        "artifactLocation": {
         "uri": "demo/codeql-code-scanning/app/app.py"
        },
        "region": {
         "startLine": 49
        }
       }
      }
     ]
    },
    {
     "ruleId": "py/command-line-injection",
     "rule": {
      "id": "py/command-line-injection",
      "toolComponent": {
       "index": 0
      }
     },
     "message": {
      "text": "This command line depends on a user-provided value."
     },
     "locations": [
      {
       "physicalLocation": {
        "artifactLocation": {
         "uri": "demo/codeql-code-scanning/app/app.py"
        },
        "region": {
         "startLine": 57
        }
       }
      }
     ]
    },
    {
     "ruleId": "py/reflective-xss",
     "rule": {
      "id": "py/reflective-xss",
      "toolComponent": {
       "index": 0
      }
     },
     "message": {
      "text": "Cross-site scripting vulnerability due to a user-provided value."
     },
     "locations": [
      {
       "physicalLocation": {
        "artifactLocation": {
         "uri": "demo/codeql-code-scanning/app/app.py"
        },
        "region": {
         "startLine": 65
        }
       }
      }
     ]
    },
    {
     "ruleId": "py/path-injection",
     "rule": {
      "id": "py/path-injection",
      "toolComponent": {
       "index": 0
      }
     },
     "message": {
      "text": "This path depends on a user-provided value."
     },
     "locations": [
      {
       "physicalLocation": {
        "artifactLocation": {
         "uri": "demo/codeql-code-scanning/app/app.py"
        },
        "region": {
         "startLine": 72
        }
       }
      }
     ]
    },
    {
     "ruleId": "py/flask-debug",
     "rule": {
      "id": "py/flask-debug",
      "toolComponent": {
       "index": 0
      }
     },
     "message": {
      "text": "A Flask app appears to be run in debug mode."
     },
     "locations": [
      {
       "physicalLocation": {
        "artifactLocation": {
         "uri": "demo/codeql-code-scanning/app/app.py"
        },
        "region": {
         "startLine": 79
        }
       }
      }
     ]
    },
    {
     "ruleId": "py/unsafe-deserialization",
     "rule": {
      "id": "py/unsafe-deserialization",
      "toolComponent": {
       "index": 0
      }
     },
     "message": {
      "text": "Unsafe deserialization depends on a user-provided value."
     },
     "locations": [
      {
       "physicalLocation": {
        "artifactLocation": {
         "uri": "demo/copilot-autofix/autofix_app.py"
        },
        "region": {
         "startLine": 20
        }
       }
      }
     ]
    },
    {
     "ruleId": "py/weak-sensitive-data-hashing",
     "rule": {
      "id": "py/weak-sensitive-data-hashing",
      "toolComponent": {
       "index": 0
      }
     },
     "message": {
      "text": "Sensitive data is used in a hashing algorithm that is insecure."
     },
     "locations": [
      {
       "physicalLocation": {
        "artifactLocation": {
         "uri": "demo/copilot-autofix/autofix_app.py"
        },
        "region": {
         "startLine": 29
        }
       }
      }
     ]
    },
    {
     "ruleId": "py/url-redirection",
     "rule": {
      "id": "py/url-redirection",
      "toolComponent": {
       "index": 0
      }
     },
     "message": {
      "text": "Untrusted URL redirection depends on a user-provided value."
     },
     "locations": [
      {
       "physicalLocation": {
        "artifactLocation": {
         "uri": "demo/copilot-autofix/autofix_app.py"
        },
        "region": {
         "startLine": 37
        }
       }
      }
     ]
    },
    {
     "ruleId": "py/unused-import",
     "rule": {
      "id": "py/unused-import",
      "toolComponent": {
       "index": 0
      }
     },
     "message": {
      "text": "Import of 'base64' is not used."
     },
     "locations": [
      {
       "physicalLocation": {
        "artifactLocation": {
         "uri": "demo/copilot-autofix/autofix_app.py"
        },
        "region": {
         "startLine": 6
        }
       }
      }
     ]
    }
   ]
  }
 ]
}